# Android SDK location template — copy to local.properties and fill in (do NOT commit local.properties)
sdk.dir=/path/to/android/sdk

# Tuya IoT platform credentials (must match applicationId com.sweeper.demo.set)
appKey=your_AppKey
appSecret=your_AppSecret

# Optional: custom debug signing (falls back to values in app/build.gradle.kts)
# KEYSTORE_FILE=/path/to/keystore
# KEYSTORE_PASSWORD=your_password
# KEY_ALIAS=key0
# KEY_PASSWORD=your_password
